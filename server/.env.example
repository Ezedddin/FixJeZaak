DATABASE_URL="file:./dev.db"

# Central AI provider configuration. Model name is configurable so it can be
# bumped (or swapped to a different Claude tier) without code changes.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

PORT=4000
CORS_ORIGIN=*

# Required to list booking requests (GET /bookings, header "x-admin-token").
# Without it that endpoint stays disabled.
ADMIN_TOKEN=

# E-mail to the juristen for new booking requests (via https://resend.com).
# Leave empty to skip sending; requests are always stored either way.
RESEND_API_KEY=
EMAIL_FROM=
JURIST_HASAN_EMAIL=
JURIST_EZEDDIN_EMAIL=
